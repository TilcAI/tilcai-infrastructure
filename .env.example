# ── TilcAI infrastructure ────────────────────────────────────────────────────
# Copy to .env. Never commit the filled file. Sections: 1 core · 2 relayer · 3 Stellar submitter ·
# 4 RPCs · 5 testnet contracts · 6 monitoring · 7 QR mock · 8 fiat providers · 9 mainnet · 10 e2e.

# ── 1. Core ──────────────────────────────────────────────────────────────────
TILCAI_ENV=testnet
# Mainnet stays read-only during phase 1. Enabling this later requires a separate review.
MAINNET_TRANSACTIONS_ENABLED=false
LOG_LEVEL=info

# HTTP API. Bind to loopback: TilcAI and the Relayer live on the same host.
API_HOST=127.0.0.1
API_PORT=8787
# Comma-separated bearer keys for service-to-service calls (openssl rand -hex 32).
# Empty = loopback only, no auth (dev). With a vault, always set it.
TILCAI_API_KEYS=

DATABASE_PATH=./data/tilcai.db
WORKER_POLL_MS=4000
QUOTE_TTL_SECONDS=900
EVM_MIN_CONFIRMATIONS=1

# Testnet developer payer (custodial TEST key; enables modes dev_signer / dev_gasless).
# Needs Fuji USDC + a little AVAX. Never set this outside testnet.
DEV_EVM_PAYER_PRIVATE_KEY=

# ── 2. OpenZeppelin Relayer ──────────────────────────────────────────────────
# Production: same host → http://localhost:8080. LAN test box: http://192.168.1.57:8080
RELAYER_URL=http://localhost:8080
RELAYER_API_KEY=
RELAYER_STELLAR_ID=stellar-example
RELAYER_FUJI_ID=avalanche-fuji-relayer
# Pays the gas in MON on Monad Testnet (chain 10143).
RELAYER_MONAD_TESTNET_ID=monad-testnet-relayer
RELAYER_X402_PLUGIN_ID=x402
# The relayer's WEBHOOK_SIGNING_KEY: its notifications go to POST /v1/webhooks/relayer.
# Empty = only unsigned notifications from this host are accepted.
RELAYER_WEBHOOK_SIGNING_KEY=

# ── 3. Stellar submitter ─────────────────────────────────────────────────────
# Who submits CctpForwarder.mint_and_forward on Stellar: relayer | local
STELLAR_MINT_SUBMITTER=relayer
# Only for STELLAR_MINT_SUBMITTER=local (operator account that pays XLM fees)
STELLAR_OPERATOR_SECRET=
# Optional existing G… used as source of read-only simulations
STELLAR_SIMULATION_SOURCE=

# ── 4. Testnet RPCs (defaults are public endpoints) ──────────────────────────
# RPC_AVALANCHE_FUJI=https://api.avax-test.network/ext/bc/C/rpc
# RPC_MONAD_TESTNET=https://testnet-rpc.monad.xyz
# RPC_STELLAR_TESTNET=https://soroban-testnet.stellar.org
# HORIZON_STELLAR_TESTNET=https://horizon-testnet.stellar.org
# IRIS_API_URL=https://iris-api-sandbox.circle.com

# ── 5. Testnet contracts ─────────────────────────────────────────────────────
# Empty = that feature is off on that network.
# Avalanche Fuji. Router = gasless burn (TilcaiCctpRouter + EVM relayer).
CCTP_ROUTER_FUJI=0x297ce6a2787484db4bB18A96a8F28A9881Fc163C
# Smart accounts (fase SCA): factory enables /v1/accounts, RouterV2 the `account` payment mode.
# Deploy both with `npm run sca -- deploy`. Unaudited: testnet only.
ACCOUNT_FACTORY_FUJI=0x55a5b0ed47c5dfb168cfe2b431a56455576d51b8
CCTP_ROUTER_V2_FUJI=0x09483803916e6cb2027741c9287361ad55507a66
# Vault pays out purchases settled off-chain; its operator must be the RELAYER_FUJI_ID account.
# Deploy with `npm run vault -- deploy`.
VAULT_FUJI=0x841dD47Db3124839be1D878DD277e1b07D6932b6

# Monad Testnet. Deploy with `npm run sca -- deploy|deploy-router --network monad-testnet`
# and `npm run vault -- deploy --network monad-testnet`.
CCTP_ROUTER_MONAD_TESTNET=0x7fbef1b0a60021b53f1d780d6794ac2dbcc9647f
CCTP_ROUTER_V2_MONAD_TESTNET=0x4ffbd69675d2a55c8ef52b8cd93cc1ac952ccbfe
ACCOUNT_FACTORY_MONAD_TESTNET=0x38c2e921e2336ea59fbc58db1eeb8c106f11d958
VAULT_MONAD_TESTNET=0xaa9e6460b6ba396c0b84029f347ff71255130c89

# Stellar Testnet. `tilcai_account_factory` enables /v1/accounts (network stellar:testnet),
# `tilcai_vault` enables /v1/vault?network=stellar:testnet. Both are printed by
# `contracts/soroban/deploy-testnet.sh`. The vault's operator must be the RELAYER_STELLAR_ID account
# (`npm run stellar -- relayer`).
ACCOUNT_FACTORY_STELLAR=
VAULT_STELLAR=

# ── 6. Monitoring (events and resources for the dashboard in tilcai-web) ─────
# Ingest endpoint of tilcai-web. Empty = events only stay in this database (GET /v1/monitor/events).
MONITOR_WEB_URL=
# Same value as MONITOR_INGEST_SECRET in tilcai-web (16+ characters):  openssl rand -hex 32
MONITOR_WEB_SECRET=
# MONITOR_RESOURCES_INTERVAL_MS=30000
# MONITOR_RETENTION_DAYS=14

# ── 7. QR Simple mock (Vendis "QR Dinámico para Pagos" API v1.3). Moves no money. ──
# Serves /mock/vendis: login, generate, status, the payment callback and the
# "Simular depósito" page at /mock/vendis/. Forbidden on mainnet.
QR_MOCK_ENABLED=false
QR_MOCK_EMAIL=
QR_MOCK_PASSWORD=
# The caller's callback, e.g. http://localhost:3200/api/v1/devices/simple-qr/callback
QR_MOCK_CALLBACK_URL=
# Base of `qr_url` as the caller reaches this API. Empty = http://API_HOST:API_PORT
QR_MOCK_PUBLIC_URL=
# Lets a browser on another machine open the simulator: /mock/vendis/?key=…
QR_MOCK_SIMULATOR_KEY=
# Contenido fijo de las imágenes de QR (demos). Vacío = qr-mock-payload.txt junto a DATABASE_PATH, si existe.
# QR_MOCK_PAYLOAD=
# QR_MOCK_PAYLOAD_FILE=

# ── 8. Fiat providers (QR Simple) ────────────────────────────────────────────
# Not read by this repository's code yet; kept here for the integration that will use them.
# Banco Económico
BANECO_USER=
BANECO_PASSWORD=
BANECO_ENCRIPTION_KEY=
BANECO_PAYMENT_ACCOUNT=
# ATC Red Enlace Open Hub
ATC_CLIENT_ID=
ATC_CLIENT_SECRET=

# ── 9. Mainnet ───────────────────────────────────────────────────────────────
# A mainnet instance is another process of the same code with TILCAI_ENV=mainnet and the values
# below (deploy/docker-compose.mainnet.yml runs it next to testnet). It starts read-only and moves
# real funds only with MAINNET_TRANSACTIONS_ENABLED=true. Database, API keys, relayer ids, RPCs and
# contract addresses must differ from the testnet ones; the relayer URL and key may be shared.
# DEV_EVM_PAYER_PRIVATE_KEY, STELLAR_OPERATOR_SECRET and QR_MOCK_ENABLED are forbidden there.
TILCAI_API_KEYS_MAINNET=
DATABASE_PATH_MAINNET=./data/tilcai-mainnet.db
EVM_MIN_CONFIRMATIONS_MAINNET=1

# Relayer
RELAYER_URL_MAINNET=
RELAYER_API_KEY_MAINNET=
RELAYER_AVALANCHE_MAINNET_ID=avalanche-mainnet-relayer
RELAYER_STELLAR_MAINNET_ID=stellar-mainnet-relayer
# Optional: x402 through the relayer's plugin, and the relayer's signed webhooks.
RELAYER_X402_PLUGIN_ID_MAINNET=
RELAYER_WEBHOOK_SIGNING_KEY_MAINNET=

# Public endpoints. Use production providers with an SLA before launch.
RPC_AVALANCHE_MAINNET=https://api.avax.network/ext/bc/C/rpc
RPC_STELLAR_MAINNET=https://soroban-rpc.mainnet.stellar.gateway.fm
HORIZON_STELLAR_MAINNET=https://horizon.stellar.org
IRIS_API_URL_MAINNET=https://iris-api.circle.com
STELLAR_SIMULATION_SOURCE_MAINNET=

# Contracts. Required: TilcaiCctpRouter on Avalanche C-Chain (deployed 2026-10-10, see
# deploy/MAINNET_DEPLOYMENT.md). The rest are reported deployed but not yet registered/verified
# there: each one turns a feature on once its deployment is verified. Never use testnet values.
CCTP_ROUTER_AVALANCHE_MAINNET=0xf6a2EdE00c441863519C6B30A1eb2d04E61847AB
CCTP_ROUTER_V2_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_AVALANCHE_MAINNET=
VAULT_AVALANCHE_MAINNET=
ERC4337_ENTRYPOINT_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_STELLAR_MAINNET=
VAULT_STELLAR_MAINNET=

# Dashboard
MONITOR_WEB_URL_MAINNET=
MONITOR_WEB_SECRET_MAINNET=

# ── 10. Tests ────────────────────────────────────────────────────────────────
# Integration (npm run test:integration)
# XPAY_PAY_TO=G…   (Stellar account WITH a USDC trustline)
# XPAY_AMOUNT=0.1
# End-to-end over HTTP (npm run e2e:gasless), against testnet or mainnet
# E2E_API_URL=http://127.0.0.1:8787
# E2E_API_KEY=
# E2E_PAYER_PRIVATE_KEY=

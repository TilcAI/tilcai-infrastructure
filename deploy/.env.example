# ── TilcAI stack (deploy/docker-compose.yml) — TESTNET ONLY ──────────────────
# Copy to deploy/.env. Never commit the filled file.

# Images to run (see deploy/build.sh).
REGISTRY=tilcai
TAG=local

# Host ports (loopback only).
RELAYER_PORT=8080
TILCAI_PORT=8787

LOG_LEVEL=info

# ── OpenZeppelin Relayer ─────────────────────────────────────────────────────
# Bearer key of the relayer API, 32+ characters:  openssl rand -hex 32
RELAYER_API_KEY=
# Passphrase of the signer keystore.
KEYSTORE_PASSPHRASE=
# The keystore file, base64-encoded:  base64 -w0 config/keys/local-signer.json
# Its addresses pay the gas (AVAX on Fuji, XLM on Stellar): reuse the funded keystore.
KEYSTORE_JSON_B64=

# ── TilcAI ───────────────────────────────────────────────────────────────────
# Comma-separated bearer keys accepted by the API:  openssl rand -hex 32
TILCAI_API_KEYS=
# Deployed TilcaiCctpRouter on Avalanche Fuji (enables the gasless modes).
CCTP_ROUTER_FUJI=0x297ce6a2787484db4bB18A96a8F28A9881Fc163C
# Deployed TilcaiVault on Avalanche Fuji (enables /v1/vault). Empty = no payouts.
VAULT_FUJI=0x841dD47Db3124839be1D878DD277e1b07D6932b6
RELAYER_STELLAR_ID=stellar-example
RELAYER_FUJI_ID=avalanche-fuji-relayer
RELAYER_X402_PLUGIN_ID=x402
STELLAR_MINT_SUBMITTER=relayer
STELLAR_OPERATOR_SECRET=
STELLAR_SIMULATION_SOURCE=
# Testnet developer payer (modes dev_signer / dev_gasless). Leave empty unless testing.
DEV_EVM_PAYER_PRIVATE_KEY=
# Optional replica of the SQLite database: gcs://bucket/tilcai, s3://bucket/tilcai, abs://…
LITESTREAM_REPLICA_URL=

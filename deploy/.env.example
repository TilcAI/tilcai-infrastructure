# ── TilcAI stack (deploy/docker-compose.yml) ─────────────────────────────────
# Copy to deploy/.env. Never commit the filled file.

# Images to run (see deploy/build.sh).
REGISTRY=tilcai
TAG=local

# Host ports (loopback only).
RELAYER_PORT=8080
TILCAI_PORT=8787

LOG_LEVEL=info
TILCAI_ENV=testnet
MAINNET_TRANSACTIONS_ENABLED=false

# ── OpenZeppelin Relayer ─────────────────────────────────────────────────────
# Bearer key of the relayer API, 32+ characters:  openssl rand -hex 32
RELAYER_API_KEY=
# Passphrase of the signer keystore.
KEYSTORE_PASSPHRASE=
# The keystore file, base64-encoded:  base64 -w0 config/keys/local-signer.json
# Its addresses pay the gas (AVAX on Fuji, XLM on Stellar): reuse the funded keystore.
KEYSTORE_JSON_B64=

# Signs the relayer's notifications to TilcAI (transaction updates, relayer disabled…):
#   openssl rand -hex 32
WEBHOOK_SIGNING_KEY=

# ── TilcAI ───────────────────────────────────────────────────────────────────
# Comma-separated bearer keys accepted by the API:  openssl rand -hex 32
TILCAI_API_KEYS=
# Deployed TilcaiCctpRouter on Avalanche Fuji (enables the gasless modes).
CCTP_ROUTER_FUJI=0x297ce6a2787484db4bB18A96a8F28A9881Fc163C
# Fase SCA: TilcaiAccountFactory (enables /v1/accounts) and TilcaiCctpRouterV2 (payments from smart accounts).
ACCOUNT_FACTORY_FUJI=0x55a5b0ed47c5dfb168cfe2b431a56455576d51b8
CCTP_ROUTER_V2_FUJI=0x09483803916e6cb2027741c9287361ad55507a66
# Deployed TilcaiVault on Avalanche Fuji (enables /v1/vault). Empty = no payouts.
VAULT_FUJI=0x841dD47Db3124839be1D878DD277e1b07D6932b6
RELAYER_STELLAR_ID=stellar-example
RELAYER_FUJI_ID=avalanche-fuji-relayer
RELAYER_X402_PLUGIN_ID=x402
STELLAR_MINT_SUBMITTER=relayer
STELLAR_OPERATOR_SECRET=
STELLAR_SIMULATION_SOURCE=
ACCOUNT_FACTORY_STELLAR=
VAULT_STELLAR=
RPC_AVALANCHE_FUJI=https://api.avax-test.network/ext/bc/C/rpc
RPC_STELLAR_TESTNET=https://soroban-testnet.stellar.org
HORIZON_STELLAR_TESTNET=https://horizon-testnet.stellar.org
IRIS_API_URL=https://iris-api-sandbox.circle.com
WORKER_POLL_MS=4000
QUOTE_TTL_SECONDS=900
EVM_MIN_CONFIRMATIONS=1
# Testnet developer payer (modes dev_signer / dev_gasless). Leave empty unless testing.
DEV_EVM_PAYER_PRIVATE_KEY=
# Optional replica of the SQLite database: gcs://bucket/tilcai, s3://bucket/tilcai, abs://…
LITESTREAM_REPLICA_URL=

# ── Monitoring dashboard (tilcai-web) ────────────────────────────────────────
# Where TilcAI pushes its events: <tilcai-web>/api/monitor/events. Empty = no push.
MONITOR_WEB_URL=
# Same value as MONITOR_INGEST_SECRET in tilcai-web:  openssl rand -hex 32
MONITOR_WEB_SECRET=

# ── QR Simple mock (Vendis API). Moves no money: demos only. ─────────────────
QR_MOCK_ENABLED=false
QR_MOCK_EMAIL=
QR_MOCK_PASSWORD=
# The caller's callback: http://<optipagos-backend>/api/v1/devices/simple-qr/callback
QR_MOCK_CALLBACK_URL=
# Base of `qr_url` as the caller reaches TilcAI, e.g. http://tilcai:8787
QR_MOCK_PUBLIC_URL=
# Opens the "Simular depósito" page to browsers outside the container: /mock/vendis/?key=…
QR_MOCK_SIMULATOR_KEY=

# ── Mainnet phase 1 (fails closed; no transactions or deployments) ──────────
TILCAI_API_KEYS_MAINNET=
DATABASE_PATH_MAINNET=/data/tilcai-mainnet.db
RELAYER_URL_MAINNET=
RELAYER_API_KEY_MAINNET=
RELAYER_AVALANCHE_MAINNET_ID=
RELAYER_STELLAR_MAINNET_ID=
RELAYER_X402_PLUGIN_ID_MAINNET=
MONITOR_WEB_URL_MAINNET=
MONITOR_WEB_SECRET_MAINNET=
RELAYER_WEBHOOK_SIGNING_KEY_MAINNET=
RPC_AVALANCHE_MAINNET=https://api.avax.network/ext/bc/C/rpc
RPC_STELLAR_MAINNET=https://soroban-rpc.mainnet.stellar.gateway.fm
HORIZON_STELLAR_MAINNET=https://horizon.stellar.lobstr.co
IRIS_API_URL_MAINNET=https://iris-api.circle.com
STELLAR_SIMULATION_SOURCE_MAINNET=
EVM_MIN_CONFIRMATIONS_MAINNET=1
# PENDING until audited TilcAI contracts are deployed and verified.
CCTP_ROUTER_AVALANCHE_MAINNET=
CCTP_ROUTER_V2_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_AVALANCHE_MAINNET=
VAULT_AVALANCHE_MAINNET=
ERC4337_ENTRYPOINT_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_STELLAR_MAINNET=
VAULT_STELLAR_MAINNET=

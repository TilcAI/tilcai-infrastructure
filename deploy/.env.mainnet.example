# Mainnet preparation only. This file intentionally contains no usable credentials,
# deployed TilcAI contract addresses, signer material, or approved image tag.
# Never commit a populated copy. Supply secrets from a secret manager.

# Immutable images built from reviewed source and an exact RELAYER_REF commit.
MAINNET_REGISTRY=tilcai
MAINNET_TAG=
RELAYER_REF=
MAINNET_TILCAI_PORT=18787
MAINNET_RELAYER_PORT=18080
LOG_LEVEL=info
MAINNET_TRANSACTIONS_ENABLED=false
QR_MOCK_ENABLED=false

# Public roles for the two dry-run commands (not consumed by Compose).
MAINNET_EVM_DEPLOYER=
MAINNET_EVM_VAULT_OWNER=
MAINNET_EVM_VAULT_OPERATOR=
MAINNET_STELLAR_DEPLOYER=
MAINNET_STELLAR_VAULT_OWNER=
MAINNET_STELLAR_VAULT_OPERATOR=

# Separate Mainnet credentials. Do not reuse Testnet values.
MAINNET_TILCAI_API_KEYS=
MAINNET_RELAYER_API_KEY=
MAINNET_WEBHOOK_SIGNING_KEY=
MAINNET_RELAYER_STORAGE_ENCRYPTION_KEY=
MAINNET_EVM_KEYSTORE_PASSPHRASE=
MAINNET_STELLAR_KEYSTORE_PASSPHRASE=
MAINNET_EVM_KEYSTORE_JSON_B64=
MAINNET_STELLAR_KEYSTORE_JSON_B64=

# Mainnet RPC endpoints and a public, existing Stellar G-account for simulations.
RPC_AVALANCHE_MAINNET=
RPC_STELLAR_MAINNET=
HORIZON_STELLAR_MAINNET=
MAINNET_STELLAR_SIMULATION_SOURCE=

# TilcAI-owned contracts remain blank until independent review, deployment and verification.
CCTP_ROUTER_AVALANCHE_MAINNET=
CCTP_ROUTER_V2_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_AVALANCHE_MAINNET=
VAULT_AVALANCHE_MAINNET=
ERC4337_ENTRYPOINT_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_STELLAR_MAINNET=
VAULT_STELLAR_MAINNET=

# Optional event sink. Keep both blank to disable external monitoring.
MONITOR_WEB_URL_MAINNET=
MONITOR_WEB_SECRET_MAINNET=

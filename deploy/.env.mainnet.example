# ── TilcAI on mainnet (deploy/docker-compose.mainnet.yml) ────────────────────
# Copy to deploy/.env.mainnet. Never commit the filled file.
# Nothing here may repeat a testnet value: API keys, monitor secret and webhook key are new.

MAINNET_REGISTRY=tilcai
MAINNET_TAG=local
# Host port of the mainnet API (loopback only). Testnet keeps 8787.
MAINNET_TILCAI_PORT=18787
LOG_LEVEL=info

# false = read-only: quotes and status work, no payment is created. true = real funds move.
MAINNET_TRANSACTIONS_ENABLED=false

# Comma-separated bearer keys of the mainnet API:  openssl rand -hex 32
MAINNET_TILCAI_API_KEYS=

# ── OpenZeppelin Relayer ─────────────────────────────────────────────────────
# A relayer already running on this host, shared with testnet (reached through the host):
RELAYER_URL_MAINNET=http://host.docker.internal:8080
# …or the relayer of this file (`--profile relayer`): http://relayer-mainnet:8080
MAINNET_RELAYER_API_KEY=
# The relayers that sign on Avalanche C-Chain and on Stellar Public Network. Their accounts
# pay the gas (AVAX, XLM); with a vault, the Avalanche one is its operator.
RELAYER_AVALANCHE_MAINNET_ID=avalanche-mainnet-relayer
RELAYER_STELLAR_MAINNET_ID=stellar-mainnet-relayer
# Optional. The relayer's x402 plugin, when it advertises eip155:43114 and stellar:pubnet.
RELAYER_X402_PLUGIN_ID_MAINNET=
# Optional. Signs the relayer's notifications to POST /v1/webhooks/relayer of this instance.
MAINNET_WEBHOOK_SIGNING_KEY=

# ── Networks ─────────────────────────────────────────────────────────────────
# Public endpoints: fine to start, not a production decision.
RPC_AVALANCHE_MAINNET=https://api.avax.network/ext/bc/C/rpc
RPC_STELLAR_MAINNET=https://soroban-rpc.mainnet.stellar.gateway.fm
HORIZON_STELLAR_MAINNET=https://horizon.stellar.org
# Any existing G… account: source of read-only Soroban simulations (the Stellar relayer's works).
MAINNET_STELLAR_SIMULATION_SOURCE=

# ── Contracts ────────────────────────────────────────────────────────────────
# TilcaiCctpRouter on Avalanche C-Chain, deployed on 2026-10-10 (no owner, no upgrades).
# `npm run mainnet:preflight` compares its code with the compiled artifact.
CCTP_ROUTER_AVALANCHE_MAINNET=0xf6a2EdE00c441863519C6B30A1eb2d04E61847AB
# Not deployed yet. Each one turns a feature on: smart accounts (factory + router v2 +
# EntryPoint) and the vaults.
CCTP_ROUTER_V2_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_AVALANCHE_MAINNET=
ERC4337_ENTRYPOINT_AVALANCHE_MAINNET=
VAULT_AVALANCHE_MAINNET=
ACCOUNT_FACTORY_STELLAR_MAINNET=
VAULT_STELLAR_MAINNET=

# ── Monitoring dashboard (tilcai-web) ────────────────────────────────────────
# <tilcai-web>/api/monitor/events. On the same host: http://host.docker.internal:<port>/api/monitor/events
MONITOR_WEB_URL_MAINNET=
# Same value as MONITOR_INGEST_SECRET_MAINNET in tilcai-web:  openssl rand -hex 32
MONITOR_WEB_SECRET_MAINNET=

# ── Only with `--profile relayer` (a relayer of its own) ─────────────────────
# MAINNET_RELAYER_PORT=18080
# MAINNET_EVM_KEYSTORE_PASSPHRASE=
# MAINNET_STELLAR_KEYSTORE_PASSPHRASE=
# MAINNET_EVM_KEYSTORE_JSON_B64=
# MAINNET_STELLAR_KEYSTORE_JSON_B64=
# MAINNET_RELAYER_STORAGE_ENCRYPTION_KEY=

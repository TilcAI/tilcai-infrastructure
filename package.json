{
  "name": "tilcai-infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "TilcAI backend: gateway, crosschain USDC payments (CCTP V2), x402 rail and relayer integration",
  "type": "module",
  "engines": { "node": ">=22.20.0" },
  "scripts": {
    "api": "tsx src/apps/api/main.ts",
    "worker": "tsx src/apps/worker/main.ts",
    "start": "tsx src/apps/all-in-one.ts",
    "xpay": "tsx src/apps/cli/crosschain-pay.ts",
    "relayer:check": "tsx src/apps/cli/relayer-check.ts",
    "sca:preflight": "tsx src/apps/cli/sca-preflight.ts",
    "mainnet:preflight": "tsx src/apps/cli/mainnet-preflight.ts",
    "mainnet:avalanche": "tsx src/apps/cli/mainnet-avalanche.ts",
    "mainnet:stellar": "bash contracts/soroban/deploy-mainnet.sh",
    "sca": "tsx src/apps/cli/sca.ts",
    "vault": "tsx src/apps/cli/vault.ts",
    "stellar": "tsx src/apps/cli/stellar.ts",
    "tenant": "tsx src/apps/cli/tenant.ts",
    "test": "tsx --test \"test/unit/**/*.test.ts\"",
    "test:integration": "tsx --test \"test/integration/**/*.test.ts\"",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@stellar/stellar-sdk": "17.2.1",
    "dotenv": "18.0.5",
    "fastify": "5.12.5",
    "qrcode-generator": "2.0.4",
    "tilcai-core": "file:../tilcai-core",
    "viem": "2.57.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
